#!/usr/bin/env python3
"""Republish a raw MuJoCo LaserScan with +inf for missing returns (REP 117) and range noise.

Parameters: input_topic, output_topic, noise_stddev.
"""

import numpy as np
import rclpy
from rclpy.node import Node
from sensor_msgs.msg import LaserScan


class ScanRelay(Node):
    def __init__(self):
        super().__init__('scan_relay')
        self.noise = self.declare_parameter('noise_stddev', 0.0).value
        self.rng = np.random.default_rng()
        self.publisher = self.create_publisher(
            LaserScan, self.declare_parameter('output_topic', '/scan').value, 10)
        self.create_subscription(
            LaserScan, self.declare_parameter('input_topic', 'scan_raw').value, self.relay, 10)

    def relay(self, scan):
        ranges = np.asarray(scan.ranges, dtype=np.float32)
        valid = ranges >= scan.range_min
        if self.noise > 0.0:
            ranges[valid] += self.rng.normal(0.0, self.noise, int(valid.sum())).astype(np.float32)
        ranges[~valid] = np.inf
        scan.ranges = ranges.tolist()
        self.publisher.publish(scan)


def main():
    rclpy.init()
    try:
        rclpy.spin(ScanRelay())
    except KeyboardInterrupt:
        pass
    finally:
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
